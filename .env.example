# Local development environment template for Calsync
# Copy to .env and fill values.

API_V1_PREFIX=/api/v1

# Deduplication backend: auto | redis | supabase | memory
DEDUP_BACKEND=auto
DEDUP_TTL_SECONDS=86400

# Redis (optional)
REDIS_URL=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DEDUP_TABLE=idempotency_keys

# IMAP mailbox credentials
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN

# Polling cadence
IMAP_AUTO_POLL_ENABLED=true
IMAP_POLL_INTERVAL_SECONDS=10
IMAP_POLL_BATCH_SIZE=20

# Agent / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GMAIL_SENDER_EMAIL=

# MCP server base URLs
GMAIL_MCP_URL=
CALENDAR_MCP_URL=

# MCP endpoint paths (override only if your MCP server uses different routes)
GMAIL_MCP_SEND_PATH=/mcp/gmail/send
CALENDAR_MCP_BOOK_PATH=/mcp/calendar/book
