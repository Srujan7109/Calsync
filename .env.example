# Local development environment template for Calsync
# Copy to .env and fill values.

API_V1_PREFIX=/api/v1

# Deduplication backend: auto | redis | supabase | memory
DEDUP_BACKEND=auto
DEDUP_TTL_SECONDS=86400

# Redis (optional)
REDIS_URL=

# Supabase (optional)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DEDUP_TABLE=idempotency_keys

# IMAP mailbox credentials
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_APP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_SEARCH_CRITERIA=UNSEEN

# Polling cadence
IMAP_AUTO_POLL_ENABLED=true
IMAP_POLL_INTERVAL_SECONDS=3
IMAP_POLL_BATCH_SIZE=20
USE_GMAIL_API_POLLING=true

# Gmail push ingestion (recommended for low latency)
GMAIL_PUSH_ENABLED=false
GMAIL_PUSH_FETCH_LIMIT=20
GMAIL_PUSH_DEBOUNCE_MS=400

# Agent / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
THREAD_INTELLIGENCE_ENABLED=true
REMINDER_COOLDOWN_MINUTES=120
GMAIL_SENDER_EMAIL=

# MCP server base URLs
GMAIL_MCP_URL=http://127.0.0.1:8006
CALENDAR_MCP_URL=http://127.0.0.1:8002

# MCP endpoint paths (override only if your MCP server uses different routes)
GMAIL_MCP_SEND_PATH=/send
CALENDAR_MCP_BOOK_PATH=/book
CALENDAR_MCP_FREEBUSY_PATH=/freebusy
