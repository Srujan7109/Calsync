# CalSync.ai Calendar MCP — Environment Variables Template
# Copy this file to .env and fill in real values before running.
# NEVER commit real secrets to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://juwvxcodeaymysahyryo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_JSON=./credentials.json
GOOGLE_REFRESH_TOKEN=your-refresh-token-here
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# ── CalSync inbox & calendar ──────────────────────────────────────────────────
CALSYNC_EMAIL=calsync1.ai@gmail.com
CALENDAR_ID=primary

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8002
LOG_LEVEL=INFO
