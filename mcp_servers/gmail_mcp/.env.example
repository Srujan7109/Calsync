# CalSync.ai Gmail MCP — Environment Variables Template
# Copy this file to .env and fill in real values before running.
# NEVER commit real secrets to version control.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://juwvxcodeaymysahyryo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Path to the Desktop-app credentials.json downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_JSON=./credentials.json
# Generated by running: python auth.py  (one-time setup)
GOOGLE_REFRESH_TOKEN=to-be-generated
GOOGLE_CLIENT_ID=to-be-generated
GOOGLE_CLIENT_SECRET=to-be-generated

# ── CalSync Gmail Inbox ──────────────────────────────────────────────────────
CALSYNC_EMAIL=calsync1.ai@gmail.com

# ── Gmail Push Notifications (Pub/Sub) ──────────────────────────────────────
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/calsync-email-topic

# ── Ollama / LLM ────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8006
LOG_LEVEL=INFO
